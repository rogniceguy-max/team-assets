WEB_PORT=8092
MCP_PORT=8093
# Optional exact browser origins for independently deployed frontends.
# Leave blank when all clients use the same origin or a development proxy.
TEAM_ASSETS_CORS_ORIGINS=
# Default is the LAN no-auth mode. Set MCP_AUTH_MODE=bearer and a long random
# token only when this service is placed behind a less-trusted network.
MCP_AUTH_MODE=none
TEAM_ASSETS_MCP_TOKEN=

TEAM_ASSETS_PUBLIC_MCP_URL=http://192.168.10.28:8093
MAX_FILE_BYTES=0
UPLOAD_TTL_SECONDS=86400
STAGING_ORPHAN_TTL_SECONDS=604800
